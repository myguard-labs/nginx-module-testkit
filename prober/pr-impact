#!/usr/bin/env bash
#
# Copyright (C) 2026 Thijs Eilander
# SPDX-License-Identifier: BSD-2-Clause
#
# pr-impact -- consolidated PR-impact test runner (P2-C). Consumes
# verify-impact's target selection (P2-A) and coverage-director.sh's
# coverage-map.json (P2-B) and runs ONLY the selected targets for a PR diff,
# inside a single outer time budget, then reports TAP + JUnit + a JSON
# summary. This never widens what a PR runs beyond what verify-impact
# selected -- it is a RUNNER over that selection, not a second selector.
#
# USAGE
#   pr-impact [--base <sha>] [--budget <secs>] [--junit <file>] [--summary <file>]
#
#   --base <sha>    forwarded verbatim to verify-impact --base.
#   --budget <secs> outer wall-clock budget for phases 1-5 (default 45).
#   --junit <file>  JUnit XML output path (default pr-impact-junit.xml).
#   --summary <file> impact-summary.json output path (default impact-summary.json).
#
# FIVE PHASES, always in this order, each scoped to only ITS slice of the
# selection: (1) selected unit tests, (2) selected ASan/UBSan fuzz corpus
# replay, (3) selected unit test binary under Memcheck, (4) changed-coverage
# assertion via coverage-map.json, (5) selected mutation cases. Each phase
# reports ok/not ok in TAP; an empty phase always carries an explained
# classification string, never a bare silent skip.
#
# BUDGET. Computed ONCE at start via bash's own $SECONDS counter (not `date`,
# which a caller-adjusted clock or a leap second could skew mid-run). Each
# phase checks remaining budget before it starts; a phase that cannot fit
# reports "not ok" with an explained "budget exhausted" classification --
# never a silent skip, and never an overrun past the deadline.
#
# EXIT STATUS. verify-impact's own FAIL-CLOSED contract (an unmapped changed
# executable line) is propagated as-is from this script's own exit status --
# an unmapped diff is a hard failure of pr-impact too, not swallowed into
# "phases all reported empty".
set -euo pipefail
export LC_ALL=C

cd "$(dirname "$0")"

VERIFY_IMPACT="$PWD/verify-impact"
COVERAGE_MAP="$PWD/coverage-map.json"
VALGRIND_SUPP="$PWD/valgrind.supp"

BASE=""
BUDGET=45
JUNIT="pr-impact-junit.xml"
SUMMARY="impact-summary.json"

while [ $# -gt 0 ]; do
    case "$1" in
        --base)
            BASE="${2:?--base requires a <sha>}"
            shift 2
            ;;
        --budget)
            BUDGET="${2:?--budget requires <secs>}"
            shift 2
            ;;
        --junit)
            JUNIT="${2:?--junit requires <file>}"
            shift 2
            ;;
        --summary)
            SUMMARY="${2:?--summary requires <file>}"
            shift 2
            ;;
        *)
            echo "pr-impact: unknown argument: $1" >&2
            exit 2
            ;;
    esac
done

# --- budget: computed ONCE, checked before each phase -----------------------
SECONDS=0
DEADLINE="$BUDGET"

remaining() {
    local left=$((DEADLINE - SECONDS))
    [ "$left" -lt 0 ] && left=0
    printf '%s\n' "$left"
}

# --- run verify-impact once; classify its rows into per-phase sets ---------
VI_OUT="$(mktemp)"
VI_ERR="$(mktemp)"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/pr-impact.XXXXXX")"
# shellcheck disable=SC2317 # invoked indirectly via `trap ... EXIT`, not a dead call
cleanup() { rm -f "$VI_OUT" "$VI_ERR"; rm -rf "$WORK"; }
trap cleanup EXIT

if [ -n "$BASE" ]; then
    vi_set=("$VERIFY_IMPACT" --base "$BASE")
else
    vi_set=("$VERIFY_IMPACT")
fi

set +e
"${vi_set[@]}" >"$VI_OUT" 2>"$VI_ERR"
VI_STATUS=$?
set -e

cat "$VI_ERR" >&2 || true

# unit test targets (named _test or ALL_UNIT_TESTS), fuzz targets, mutation
# names, scenario/corpus rows -- each collected sorted+deduped.
UNIT_TESTS="$(mktemp)"
FUZZ_TARGETS="$(mktemp)"
MUTATIONS="$(mktemp)"
SCENARIOS="$(mktemp)"
: >"$UNIT_TESTS"; : >"$FUZZ_TARGETS"; : >"$MUTATIONS"; : >"$SCENARIOS"

ALL_UNIT_SELECTED=0

if [ "$VI_STATUS" -eq 0 ] && [ -s "$VI_OUT" ]; then
    while IFS=$'\t' read -r target _lane; do
        [ -n "$target" ] || continue
        case "$target" in
            ALL_UNIT_TESTS)
                ALL_UNIT_SELECTED=1
                ;;
            fuzz/*)
                printf '%s\n' "${target#fuzz/}" >>"$FUZZ_TARGETS"
                ;;
            mutate:*)
                printf '%s\n' "${target#mutate:}" >>"$MUTATIONS"
                ;;
            scenarios/*|corpus/*)
                printf '%s\n' "$target" >>"$SCENARIOS"
                ;;
            *_test)
                printf '%s\n' "$target" >>"$UNIT_TESTS"
                ;;
            *)
                # Anything else verify-impact might legitimately emit (a
                # scenario dir without the scenarios/ prefix, etc.) is kept
                # in the scenarios bucket rather than dropped silently.
                printf '%s\n' "$target" >>"$SCENARIOS"
                ;;
        esac
    done <"$VI_OUT"
fi

if [ "$ALL_UNIT_SELECTED" -eq 1 ]; then
    for src in *_test.c; do
        [ -e "$src" ] || continue
        printf '%s\n' "${src%.c}" >>"$UNIT_TESTS"
    done
fi

sort_uniq() { LC_ALL=C sort -u "$1"; }

UNIT_LIST="$(sort_uniq "$UNIT_TESTS")"
FUZZ_LIST="$(sort_uniq "$FUZZ_TARGETS")"
MUT_LIST="$(sort_uniq "$MUTATIONS")"

# --- TAP + per-phase bookkeeping --------------------------------------------
echo "1..5"

PHASE_NAMES=(unit_test fuzz_replay memcheck_microtarget changed_coverage mapped_mutation)
declare -A PHASE_STATUS   # ok | not_ok
declare -A PHASE_CLASS    # explanation string
declare -A PHASE_SELECTED # newline-joined selected list
declare -A PHASE_ELAPSED  # ms

phase_json_escape() {
    # Minimal JSON string escaper: backslash, quote, control chars.
    printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()), end="")' 2>/dev/null \
        || printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
}

report_phase() {   # $1=index(1-5) $2=name $3=status(ok|not_ok) $4=classification $5=selected(nl-joined) $6=elapsed_ms
    local idx="$1" name="$2" status="$3" class="$4" selected="$5" elapsed="$6"
    PHASE_STATUS["$name"]="$status"
    PHASE_CLASS["$name"]="$class"
    PHASE_SELECTED["$name"]="$selected"
    PHASE_ELAPSED["$name"]="$elapsed"
    if [ "$status" = "ok" ]; then
        echo "ok $idx $name - $class"
    else
        echo "not ok $idx $name - $class"
    fi
}

# --- shared build inputs for phases 1 (unit test) and 2 (fuzz replay) ------
# Computed ONCE here rather than duplicated per-phase (and, in phase 1's old
# form, recomputed via a fresh pkg-config subprocess for every rebuilt test --
# CodeRabbit, pr-impact:224). Both phases link the same consumer source set;
# phase 3 keeps its OWN copy deliberately (its -O0 pinned-toolchain memcheck
# build must stay independent of ambient $CC -- see the phase 3 header note).
LIB="json.c http.c util.c rules.c assert.c backend.c"
LDFLAGS="${LDFLAGS:-}"
if command -v pkg-config >/dev/null 2>&1; then
    LDFLAGS="$LDFLAGS $(pkg-config --libs openssl 2>/dev/null || echo '-lssl -lcrypto')"
    LDFLAGS="$LDFLAGS $(pkg-config --libs zlib 2>/dev/null || echo '-lz')"
else
    LDFLAGS="$LDFLAGS -lssl -lcrypto -lz"
fi
LDLIBS="$LDFLAGS"
CC="${CC:-cc}"

# =========================== PHASE 1: unit tests ============================
p1_start="$SECONDS"
if [ -z "$UNIT_LIST" ]; then
    report_phase 1 unit_test ok "no unit test selected by diff" "" "$(( (SECONDS - p1_start) * 1000 ))"
elif [ "$(remaining)" -le 0 ]; then
    report_phase 1 unit_test not_ok "budget exhausted before phase could start" "$UNIT_LIST" "$(( (SECONDS - p1_start) * 1000 ))"
else
    p1_rc=0
    p1_detail=""
    while IFS= read -r t; do
        [ -n "$t" ] || continue
        # Re-check remaining budget on EVERY iteration, not just once before
        # the loop: several selected unit tests, each individually fast, can
        # still exhaust the whole outer budget in aggregate (CodeRabbit,
        # pr-impact:229) -- phases 2/3 already did this, phase 1 did not.
        left="$(remaining)"
        if [ "$left" -le 0 ]; then
            p1_rc=1
            p1_detail="$p1_detail budget exhausted before $t;"
            break
        fi
        src="$t.c"
        bin="$t"
        if [ ! -e "$src" ]; then
            p1_rc=1
            p1_detail="$p1_detail $t: source missing;"
            continue
        fi
        # Reuse a fresh binary if present (mtime check mirroring build.sh):
        # rebuild only when missing or older than its source.
        if [ ! -x "$bin" ] || [ "$src" -nt "$bin" ]; then
            # $CC MUST be word-split (unquoted), not `"$CC"` -- CI's 32-bit
            # leg sets CC="gcc -m32" (a compiler COMMAND, not a bare binary
            # name), exactly like build.sh already handles it (`compile $CC
            # $CFLAGS ...`, unquoted). Quoting "$CC" here treats "gcc -m32"
            # as one literal binary name and fails with "command not found"
            # (verified: exit 127) -- confirmed as the real regression this
            # exact bug caused in CI's build-32bit leg.
            # shellcheck disable=SC2086
            if ! $CC -O1 -g -std=c11 -o "$bin" "$src" $LIB $LDFLAGS 2>"$WORK/p1_build_$t.log"; then
                p1_rc=1
                p1_detail="$p1_detail $t: build failed;"
                continue
            fi
        fi
        # A hung unit test (infinite loop, blocking I/O) must not be able to
        # overrun the outer budget: bound the run itself, not just the
        # between-iteration checks (CodeRabbit, pr-impact:229, CRITICAL --
        # this is the runner's own load-bearing invariant).
        left="$(remaining)"
        if [ "$left" -le 0 ]; then
            p1_rc=1
            p1_detail="$p1_detail budget exhausted before running $t;"
            continue
        fi
        # `if ! cmd; then rc=$?` is WRONG: bash's `!` negation collapses the
        # exit status to 0/1 before `$?` is read inside `then`, so a real
        # timeout (124) is never distinguishable from an ordinary failure --
        # found while proving this very timeout with a deliberately-slow
        # fixture. Use the NON-negated form so `$?` in the `else` branch is
        # the real underlying exit code.
        if timeout "$left" ./"$bin" >"$WORK/p1_run_$t.log" 2>&1; then
            :
        else
            rc=$?
            if [ "$rc" -eq 124 ]; then
                p1_rc=1
                p1_detail="$p1_detail $t: TIMED OUT after ${left}s (budget exhausted mid-run);"
            else
                p1_rc=1
                p1_detail="$p1_detail $t: FAILED;"
            fi
        fi
    done <<<"$UNIT_LIST"
    if [ "$p1_rc" -eq 0 ]; then
        report_phase 1 unit_test ok "selected unit test(s) passed" "$UNIT_LIST" "$(( (SECONDS - p1_start) * 1000 ))"
    else
        report_phase 1 unit_test not_ok "selected unit test(s) failed:$p1_detail" "$UNIT_LIST" "$(( (SECONDS - p1_start) * 1000 ))"
    fi
fi

# ======================= PHASE 2: ASan/UBSan fuzz replay =====================
p2_start="$SECONDS"
if [ -z "$FUZZ_LIST" ]; then
    report_phase 2 fuzz_replay ok "no fuzz target selected by diff" "" "$(( (SECONDS - p2_start) * 1000 ))"
elif [ "$(remaining)" -le 0 ]; then
    report_phase 2 fuzz_replay not_ok "budget exhausted before phase could start" "$FUZZ_LIST" "$(( (SECONDS - p2_start) * 1000 ))"
else
    # LIB/LDLIBS/CC are the phase-1/2 shared build inputs computed once above
    # (CodeRabbit, pr-impact:224) -- only the fuzz-specific ../-relative
    # LIBPATHS (fuzz/ subshells cd one level down) is local to this phase.
    LIBPATHS=""
    for f in $LIB; do
        LIBPATHS="$LIBPATHS ../$f"
    done
    SAN="-fsanitize=address,undefined -fno-omit-frame-pointer"
    export ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=1:halt_on_error=1}"
    export UBSAN_OPTIONS="${UBSAN_OPTIONS:-halt_on_error=1:print_stacktrace=1}"
    p2_rc=0
    p2_detail=""
    while IFS= read -r t; do
        [ -n "$t" ] || continue
        left="$(remaining)"
        if [ "$left" -le 0 ]; then
            p2_rc=1
            p2_detail="$p2_detail budget exhausted before $t;"
            break
        fi
        bin="$WORK/replay_$t"
        # $t is already the full "fuzz_<name>" basename (verify-impact emits
        # "fuzz/fuzz_json" and only the "fuzz/" prefix was stripped above).
        # $CC word-split, unquoted -- same reasoning as phase 1's own note:
        # CI's 32-bit leg sets CC="gcc -m32", and quoting "$CC" here would
        # fail with "command not found" instead of compiling a 32-bit
        # replay binary (this exact bug regressed CI's build-32bit leg).
        # shellcheck disable=SC2086
        if ! (cd fuzz && $CC -O1 -g -std=c11 $SAN -o "$bin" "$t.c" fuzz_standalone.c $LIBPATHS $LDLIBS) \
            2>"$WORK/p2_build_$t.log"; then
            p2_rc=1
            p2_detail="$p2_detail $t: build failed;"
            continue
        fi
        # Bound the replay itself so a genuine hang (not just a crash) can't
        # overrun the outer budget (CodeRabbit, pr-impact:229, CRITICAL).
        left="$(remaining)"
        if [ "$left" -le 0 ]; then
            p2_rc=1
            p2_detail="$p2_detail budget exhausted before running $t;"
            continue
        fi
        # Non-negated form (see phase 1's own note above): `if ! cmd; then
        # rc=$?` loses the real exit code to bash's boolean-collapsing `!`,
        # making a real 124 timeout indistinguishable from a crash.
        if ( cd fuzz && timeout "$left" "$bin" "corpus/${t#fuzz_}" >"$WORK/p2_run_$t.log" 2>&1 ); then
            :
        else
            rc=$?
            if [ "$rc" -eq 124 ]; then
                p2_rc=1
                p2_detail="$p2_detail $t: TIMED OUT after ${left}s (budget exhausted mid-run);"
            else
                p2_rc=1
                p2_detail="$p2_detail $t: crashed/aborted;"
            fi
        fi
    done <<<"$FUZZ_LIST"
    if [ "$p2_rc" -eq 0 ]; then
        report_phase 2 fuzz_replay ok "selected fuzz target(s) replayed clean" "$FUZZ_LIST" "$(( (SECONDS - p2_start) * 1000 ))"
    else
        report_phase 2 fuzz_replay not_ok "selected fuzz target(s) failed:$p2_detail" "$FUZZ_LIST" "$(( (SECONDS - p2_start) * 1000 ))"
    fi
fi

# ===================== PHASE 3: Memcheck microtarget =========================
p3_start="$SECONDS"
if [ -z "$UNIT_LIST" ]; then
    report_phase 3 memcheck_microtarget ok "no unit test selected by diff -- nothing to memcheck" "" "$(( (SECONDS - p3_start) * 1000 ))"
elif ! command -v valgrind >/dev/null 2>&1; then
    report_phase 3 memcheck_microtarget ok "SKIP -- valgrind not available on this box" "$UNIT_LIST" "$(( (SECONDS - p3_start) * 1000 ))"
elif [ "$(remaining)" -le 0 ]; then
    report_phase 3 memcheck_microtarget not_ok "budget exhausted before phase could start" "$UNIT_LIST" "$(( (SECONDS - p3_start) * 1000 ))"
else
    p3_rc=0
    p3_detail=""
    VG_SUPP_ARGS=()
    [ -f "$VALGRIND_SUPP" ] && VG_SUPP_ARGS=(--suppressions="$VALGRIND_SUPP")
    # Memcheck must not reuse phase 1's optimized (-O1, ambient $CC) binary:
    # a leak that's still observable at -O1 under gcc can be dead-code-eliminated
    # by clang at the same -O1 (the CI matrix runs CC=clang), silently making
    # the phase 3 non-vacuity mutant survive. Build a SEPARATE, memcheck-only
    # binary at -O0 with a pinned toolchain preference (gcc, falling back to
    # whatever cc/clang is available) so leak shape is deterministic across
    # the CI compiler matrix, independent of ambient $CC used by phases 1/2.
    VG_CC="$(command -v gcc || command -v cc || command -v clang)"
    # Deliberately a SEPARATE variable from the hoisted $LIB (phase 1/2 shared
    # build inputs) even though the value happens to match today: phase 3's
    # -O0/pinned-toolchain memcheck build must stay independent of whatever
    # phases 1/2 use for $CC, so it must not silently start sharing a mutable
    # variable name with them.
    VG_LIB="json.c http.c util.c rules.c assert.c backend.c"
    VG_LDFLAGS="${LDFLAGS:-}"
    if command -v pkg-config >/dev/null 2>&1; then
        VG_LDFLAGS="$VG_LDFLAGS $(pkg-config --libs openssl 2>/dev/null || echo '-lssl -lcrypto')"
        VG_LDFLAGS="$VG_LDFLAGS $(pkg-config --libs zlib 2>/dev/null || echo '-lz')"
    else
        VG_LDFLAGS="$VG_LDFLAGS -lssl -lcrypto -lz"
    fi
    while IFS= read -r t; do
        [ -n "$t" ] || continue
        left="$(remaining)"
        if [ "$left" -le 0 ]; then
            p3_rc=1
            p3_detail="$p3_detail budget exhausted before $t;"
            break
        fi
        src="$t.c"
        vg_bin="$WORK/memcheck_$t"
        if [ ! -e "$src" ]; then
            p3_rc=1
            p3_detail="$p3_detail $t: source missing;"
            continue
        fi
        # shellcheck disable=SC2086
        if ! "$VG_CC" -O0 -g -std=c11 -o "$vg_bin" "$src" $VG_LIB $VG_LDFLAGS \
            2>"$WORK/p3_build_$t.log"; then
            p3_rc=1
            p3_detail="$p3_detail $t: memcheck build failed;"
            continue
        fi
        # Bound the valgrind run itself (CodeRabbit, pr-impact:229, CRITICAL)
        # AND guard the zero-`left` edge case explicitly before constructing
        # `timeout "$left"`: GNU coreutils `timeout 0` DISABLES the timeout
        # rather than firing immediately (CodeRabbit, pr-impact:453, MINOR --
        # confirmed via upstream timeout.c: "'0' means don't timeout"), so a
        # `left` of exactly 0 must be caught as "budget exhausted" here, not
        # handed to `timeout` as an accidental "run unbounded".
        left="$(remaining)"
        if [ "$left" -le 0 ]; then
            p3_rc=1
            p3_detail="$p3_detail budget exhausted before running $t under memcheck;"
            continue
        fi
        # Non-negated form (see phase 1's own note above): `if ! cmd; then
        # rc=$?` loses the real exit code to bash's boolean-collapsing `!`.
        if timeout "$left" valgrind --error-exitcode=99 --leak-check=full \
            --errors-for-leak-kinds=definite "${VG_SUPP_ARGS[@]}" \
            "$vg_bin" >"$WORK/p3_run_$t.log" 2>&1; then
            :
        else
            rc=$?
            if [ "$rc" -eq 124 ]; then
                p3_rc=1
                p3_detail="$p3_detail $t: memcheck TIMED OUT after ${left}s (budget exhausted mid-run);"
            else
                p3_rc=1
                p3_detail="$p3_detail $t: memcheck reported an error;"
            fi
        fi
    done <<<"$UNIT_LIST"
    if [ "$p3_rc" -eq 0 ]; then
        report_phase 3 memcheck_microtarget ok "selected unit test(s) clean under memcheck" "$UNIT_LIST" "$(( (SECONDS - p3_start) * 1000 ))"
    else
        report_phase 3 memcheck_microtarget not_ok "memcheck findings:$p3_detail" "$UNIT_LIST" "$(( (SECONDS - p3_start) * 1000 ))"
    fi
fi

# ========================= PHASE 4: changed coverage ==========================
p4_start="$SECONDS"
if [ ! -f "$COVERAGE_MAP" ]; then
    report_phase 4 changed_coverage ok "coverage-map.json absent -- SKIP (repo stance: mutation over coverage%, run coverage-director.sh to opt in)" "" "$(( (SECONDS - p4_start) * 1000 ))"
elif [ -z "$UNIT_LIST" ] && [ "$ALL_UNIT_SELECTED" -eq 0 ]; then
    report_phase 4 changed_coverage ok "no unit test selected by diff -- nothing to check coverage against" "" "$(( (SECONDS - p4_start) * 1000 ))"
elif ! command -v jq >/dev/null 2>&1; then
    report_phase 4 changed_coverage ok "SKIP -- jq not available to read coverage-map.json" "" "$(( (SECONDS - p4_start) * 1000 ))"
elif [ "$(remaining)" -le 0 ]; then
    report_phase 4 changed_coverage not_ok "budget exhausted before phase could start" "$UNIT_LIST" "$(( (SECONDS - p4_start) * 1000 ))"
else
    # For every changed .c line under prober/, require it to be covered by at
    # least one SELECTED test. Changed-line extraction mirrors verify-impact's
    # own changed_lines_of (git diff -U0 hunk headers).
    p4_rc=0
    p4_detail=""
    # Pathspec MATCHING is CWD-relative (prober/, per the `cd` at the top of
    # this script), but git diff --name-only still PRINTS repo-root-relative
    # paths regardless of CWD -- so a changed prober/json.c is matched by the
    # bare '*.c' pathspec below but printed as "prober/json.c", not "json.c".
    changed_files=""
    if [ -n "$BASE" ]; then
        changed_files="$(git diff --name-only -M "$BASE"..HEAD -- '*.c' 2>/dev/null || true)"
    else
        changed_files="$(git diff --name-only -M HEAD -- '*.c' 2>/dev/null || true)"
    fi
    if [ -z "$changed_files" ]; then
        report_phase 4 changed_coverage ok "no changed prober/*.c lines to check" "$UNIT_LIST" "$(( (SECONDS - p4_start) * 1000 ))"
    else
        uncovered=""
        # Collect every changed (file,line) pair FIRST, then resolve them all
        # against coverage-map.json in a SINGLE jq invocation below, instead
        # of spawning one jq process (which fully re-parses the whole map
        # file each time) per changed line -- a diff touching dozens/hundreds
        # of lines could otherwise burn the shared 45s budget purely on
        # process-spawn + reparse overhead rather than an actual coverage gap
        # (CodeRabbit, pr-impact:427, MAJOR/heavy-lift).
        PAIRS_FILE="$WORK/p4_pairs.txt"
        : >"$PAIRS_FILE"
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            relf="prober/${f#prober/}"
            # git diff --name-only above prints repo-root-relative paths
            # ("prober/lib.c") regardless of CWD, but a `-- <path>` pathspec
            # to a SUBSEQUENT git diff is resolved against the CWD (this
            # script `cd`'d into prober/ at the top) -- so the path handed to
            # `git diff -- ` here must have the leading prober/ stripped, or
            # it resolves to a nonexistent prober/prober/lib.c and silently
            # returns no hunks (CR: caught by pr_impact_test.sh phase 4 pair).
            cf="${f#prober/}"
            if [ -n "$BASE" ]; then
                hunks="$(git diff -U0 -M "$BASE"..HEAD -- "$cf" 2>/dev/null | grep -E '^@@ ' || true)"
            else
                hunks="$(git diff -U0 -M HEAD -- "$cf" 2>/dev/null | grep -E '^@@ ' || true)"
            fi
            while IFS= read -r hdr; do
                [ -n "$hdr" ] || continue
                new_range="$(printf '%s\n' "$hdr" | sed -n 's/^@@ -[0-9,]* +\([0-9]*\)\(,\([0-9]*\)\)\{0,1\} @@.*/\1 \3/p')"
                start="${new_range%% *}"
                count="${new_range##* }"
                [ -n "$start" ] || continue
                [ -n "$count" ] || count=1
                [ "$count" -gt 0 ] || continue
                i=0
                while [ "$i" -lt "$count" ]; do
                    line=$((start + i))
                    printf '%s\t%s\n' "$relf" "$line" >>"$PAIRS_FILE"
                    i=$((i + 1))
                done
            done <<<"$hunks"
        done <<<"$changed_files"
        # One jq call: build a JSON array of {file,line} objects on the fly
        # from the tab-separated pairs file (--rawfile + `inputs`/split, no
        # per-line subprocess), look each up in coverage-map.json, and emit
        # "file\tline\tcovered_by_any(0|1 test names...)" rows -- selection
        # filtering (is a covering test actually SELECTED for this diff)
        # stays in bash against $UNIT_LIST, same as before.
        # -n (null input): this filter never reads `.` -- everything comes
        # from --rawfile/--slurpfile -- so without -n jq waits on stdin
        # (empty/closed here) and silently produces ZERO rows regardless of
        # the actual pairs/map content, which read back as "everything is
        # covered" (an uncovered-line fault would never be caught). Found
        # while verifying this very batching change against a real fault.
        cov_rows="$(jq -rn --rawfile pairs "$PAIRS_FILE" --slurpfile map "$COVERAGE_MAP" '
            $map[0] as $m |
            ($pairs | rtrimstr("\n") | split("\n") | map(select(length > 0))) as $lines |
            $lines[] | split("\t") as $p |
            ($p[0]) as $f | ($p[1]) as $l |
            ($m[$f][$l] // []) as $tests |
            "\($f)\t\($l)\t\($tests | join(","))"
        ' 2>/dev/null || true)"
        if [ -n "$cov_rows" ]; then
            while IFS=$'\t' read -r relf line testcsv; do
                [ -n "$relf" ] || continue
                covered_by_selected=0
                if [ -n "$testcsv" ]; then
                    IFS=',' read -ra tt_arr <<<"$testcsv"
                    for tt in "${tt_arr[@]}"; do
                        [ -n "$tt" ] || continue
                        if printf '%s\n' "$UNIT_LIST" | grep -qx "$tt"; then
                            covered_by_selected=1
                        fi
                    done
                fi
                if [ "$covered_by_selected" -eq 0 ]; then
                    uncovered="$uncovered $relf:$line"
                fi
            done <<<"$cov_rows"
        fi
        if [ -n "$uncovered" ]; then
            p4_rc=1
            p4_detail="changed lines not covered by any selected test:$uncovered"
        fi
        if [ "$p4_rc" -eq 0 ]; then
            report_phase 4 changed_coverage ok "every changed executable line is covered by a selected test" "$UNIT_LIST" "$(( (SECONDS - p4_start) * 1000 ))"
        else
            report_phase 4 changed_coverage not_ok "$p4_detail" "$UNIT_LIST" "$(( (SECONDS - p4_start) * 1000 ))"
        fi
    fi
fi

# ========================= PHASE 5: mapped mutation ==========================
p5_start="$SECONDS"
if [ -z "$MUT_LIST" ]; then
    report_phase 5 mapped_mutation ok "no mutation case selected by diff" "" "$(( (SECONDS - p5_start) * 1000 ))"
elif [ "$(remaining)" -le 0 ]; then
    report_phase 5 mapped_mutation not_ok "budget exhausted before phase could start" "$MUT_LIST" "$(( (SECONDS - p5_start) * 1000 ))"
else
    p5_rc=0
    p5_detail=""
    # mutate.sh's own FILTER contract is a single SUBSTRING match ("$FILTER"
    # in the mutation's name), not a regex alternation -- joining several
    # selected mutation names with `paste -sd'|'` into ONE call built a
    # literal filter like "send_slow|shutdown" that cannot substring-match
    # any real mutation name, so mutate.sh would silently select ZERO cases
    # and phase 5 would vacuously report "ok" no matter what the diff broke
    # (CodeRabbit, pr-impact:453, MAJOR -- confirmed against mutate.sh's own
    # `[[ "$name" != *"$FILTER"* ]]` matcher). Invoke mutate.sh ONCE PER
    # selected mutation name instead.
    while IFS= read -r m; do
        [ -n "$m" ] || continue
        # Same zero-`left` guard as phases 1-3: GNU `timeout 0` disables the
        # timeout instead of firing immediately (CodeRabbit, pr-impact:453,
        # MINOR), so a `left` of exactly 0 must be caught here explicitly
        # rather than handed to `timeout` as an accidental "run unbounded".
        left="$(remaining)"
        if [ "$left" -le 0 ]; then
            p5_rc=1
            p5_detail="$p5_detail budget exhausted before $m;"
            break
        fi
        if MUT_SUITE_TIMEOUT="${MUT_SUITE_TIMEOUT:-$left}" timeout "$left" \
            ./mutate.sh "$m" >>"$WORK/p5_mutate.log" 2>&1; then
            :
        else
            mrc=$?
            if [ "$mrc" -eq 124 ]; then
                p5_rc=1
                p5_detail="$p5_detail $m: budget exhausted mid-run (mutate.sh timed out);"
            else
                p5_rc=1
                p5_detail="$p5_detail $m: mutate.sh reported survived/broken case(s), see log;"
            fi
        fi
    done <<<"$MUT_LIST"
    if [ "$p5_rc" -eq 0 ]; then
        report_phase 5 mapped_mutation ok "selected mutation case(s) all caught" "$MUT_LIST" "$(( (SECONDS - p5_start) * 1000 ))"
    else
        report_phase 5 mapped_mutation not_ok "$p5_detail" "$MUT_LIST" "$(( (SECONDS - p5_start) * 1000 ))"
    fi
fi

# =============================== JUnit XML ===================================
{
    total=5
    fail_count=0
    for n in "${PHASE_NAMES[@]}"; do
        [ "${PHASE_STATUS[$n]}" = "ok" ] || fail_count=$((fail_count + 1))
    done
    printf '<?xml version="1.0" encoding="UTF-8"?>\n'
    printf '<testsuite name="pr-impact" tests="%s" failures="%s">\n' "$total" "$fail_count"
    for n in "${PHASE_NAMES[@]}"; do
        cls="${PHASE_CLASS[$n]}"
        esc_cls="$(printf '%s' "$cls" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g')"
        time_s="$(( PHASE_ELAPSED[$n] / 1000 ))"
        printf '  <testcase name="%s" classname="pr-impact" time="%s">\n' "$n" "$time_s"
        if [ "${PHASE_STATUS[$n]}" != "ok" ]; then
            printf '    <failure message="%s">%s</failure>\n' "$esc_cls" "$esc_cls"
        fi
        printf '  </testcase>\n'
    done
    printf '</testsuite>\n'
} >"$JUNIT"

# ============================ impact-summary.json ============================
#
# Byte-identical across two runs on the same inputs: sorted target lists,
# jq -S for stable key order (when jq is present -- see fallback below), no
# timestamps in the payload (elapsed_ms is the one field that legitimately
# varies run-to-run and is documented as such -- determinism is checked
# structurally by the caller, not by diffing elapsed_ms).
#
# Neither jq nor python3 is a hard prerequisite: phase 4 already treats a
# missing jq as a graceful SKIP rather than a hard dependency, so this final
# summary/JUnit write must degrade the same way instead of dying via
# set -euo pipefail's "command not found" before ANY output is produced
# (CodeRabbit, pr-impact:523, MAJOR). sel_json falls back to the same
# hand-rolled sed escaper phase_json_escape already uses when python3 is
# absent; the object is built key-by-key in a FIXED, already-deterministic
# order (PHASE_NAMES is a fixed array), so `jq -S .` is a formatting nicety,
# not a correctness requirement -- write the raw constructed JSON directly
# when jq is unavailable instead of failing.
sel_json_escape() {   # $1 = newline-joined, already-sorted+deduped list
    local out="" first=1 line
    out="["
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        [ "$first" -eq 1 ] || out="$out,"
        first=0
        out="$out$(phase_json_escape "$line")"
    done <<<"$1"
    printf '%s]' "$out"
}
SUMMARY_JSON="$(
    printf '{'
    printf '"base":%s,' "$( [ -n "$BASE" ] && phase_json_escape "$BASE" || printf 'null' )"
    printf '"budget":%s,' "$BUDGET"
    printf '"phases":{'
    first=1
    for n in "${PHASE_NAMES[@]}"; do
        [ "$first" -eq 1 ] || printf ','
        first=0
        sel_sorted="$(printf '%s\n' "${PHASE_SELECTED[$n]}" | { grep -v '^$' || true; } | LC_ALL=C sort -u)"
        if command -v python3 >/dev/null 2>&1; then
            sel_json="$(printf '%s\n' "$sel_sorted" | \
                python3 -c 'import json,sys; print(json.dumps([l.rstrip("\n") for l in sys.stdin if l.strip()]))' 2>/dev/null || true)"
        else
            sel_json=""
        fi
        if [ -z "$sel_json" ]; then
            sel_json="$(sel_json_escape "$sel_sorted")"
        fi
        printf '%s:{"selected":%s,"status":%s,"classification":%s,"elapsed_ms":%s}' \
            "$(phase_json_escape "$n")" \
            "$sel_json" \
            "$(phase_json_escape "${PHASE_STATUS[$n]}")" \
            "$(phase_json_escape "${PHASE_CLASS[$n]}")" \
            "${PHASE_ELAPSED[$n]}"
    done
    printf '}}'
)"
if command -v jq >/dev/null 2>&1; then
    printf '%s' "$SUMMARY_JSON" | jq -S . >"$SUMMARY"
else
    printf '%s\n' "$SUMMARY_JSON" >"$SUMMARY"
fi

overall=0
for n in "${PHASE_NAMES[@]}"; do
    [ "${PHASE_STATUS[$n]}" = "ok" ] || overall=1
done

# Propagate verify-impact's own fail-closed exit status: an unmapped diff
# must fail pr-impact too, not read as "five empty-but-green phases".
if [ "$VI_STATUS" -ne 0 ]; then
    exit "$VI_STATUS"
fi

exit "$overall"
