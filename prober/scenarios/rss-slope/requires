#!/usr/bin/env bash
# rss-slope needs /proc/self/smaps_rollup (Linux >= 4.14) for the RSS oracle,
# and /proc/self/fd for the probe fd fields. Skip VISIBLY where either is
# absent (a non-Linux runner, or a sandbox without smaps_rollup) rather than
# fail -- same contract as every other /proc-dependent scenario.
test -r /proc/self/smaps_rollup
