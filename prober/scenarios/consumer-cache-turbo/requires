#!/usr/bin/env bash
#
# CONSUMER-SCENARIO GATE (grind item H3, "second consumer zero-hook", modeled
# on reload-compressing's gate -- see that scenario's ./requires for the full
# rationale of the two-shape search). This scenario's nginx.conf ALWAYS loads
# @BUILD_OBJS@/ngx_http_cache_turbo_module.so unconditionally, so CI (which
# builds only the ref probe module) SKIPs cleanly rather than failing on a
# guaranteed `nginx -t` error.
#
# nonzero exit  => run-scenario.sh emits "1..0 # SKIP <stdout of this gate>"
#
# Unlike reload-compressing, this scenario needs no external CLI (no zstd, no
# python3): the oracle reads the probe's own JSON fields and an HTTP response
# header, both already-established harness idioms (prober_probe_field, plain
# curl-less /dev/tcp reads). So the ONLY gate is the .so itself.
# THE GATE MUST CHECK THE TREE THAT WILL ACTUALLY BE BOOTED -- nothing else.
# This gate used to glob `.build/*/objs` for the .so, which finds it in ANY
# staged tree. With the .so present in one tree and absent from the one being
# booted, the gate passed and nginx then died at `nginx -t` with a dlopen
# failure -- a hard FAIL where the entire purpose of the gate is a clean SKIP.
# run-scenario.sh runs this before prober_resolve, so PROBER_RESOLVED_BUILD does
# not exist yet; recompute the same path lib.sh will, taking flavor/version from
# argv ($2/$3, as run-scenario.sh passes them) with the same defaults.
FLAVOR="${2:-nginx}"
VERSION="${3:-1.31.3}"
BUILD="${PROBER_BUILD:-${PROBER_ROOT:-.}/.build/${FLAVOR}-${VERSION}}"

if [ ! -f "$BUILD/objs/ngx_http_cache_turbo_module.so" ]; then
    echo "cache_turbo module .so not found in $BUILD/objs -- nginx.conf load_modules ngx_http_cache_turbo_module.so unconditionally, so this tree cannot run the scenario; build it as a dynamic module (tools/build-consumers.sh --stage ${FLAVOR}-${VERSION}) to run this scenario"
    exit 1
fi

exit 0
